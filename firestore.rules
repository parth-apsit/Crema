rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    // Users Collection: Prevent privilege escalation
    match /users/{userId} {
      // Any authenticated user can read their own profile; admins can read all
      allow read: if isOwner(userId) || isAdmin();

      // New users can create their own profile, but cannot assign themselves 'admin'
      allow create: if isOwner(userId) &&
        request.resource.data.role == 'customer';

      // Users can update their profile information but CANNOT change their role or loyaltyPoints arbitrarily
      allow update: if (isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'address', 'orderFrequency', 'favoriteStoreId']))
        || isAdmin();

      // Only admins can delete user documents
      allow delete: if isAdmin();
    }

    // Orders Collection: Scoped to Owner or Admin with strict validation
    match /orders/{orderId} {
      // Customers can read their own orders; admins can read all orders
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();

      // Customers can create orders tied to their own UID with verified initial status and fields
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status in ['pending', 'received'] &&
        request.resource.data.totalAmount is number &&
        request.resource.data.totalAmount >= 0 &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        !request.resource.data.keys().hasAny(['role', 'isAdmin', 'refundApproved']);

      // Only admins can update order status / brewStatus (or cancel)
      allow update: if isAdmin();

      // Deletions reserved for admins
      allow delete: if isAdmin();
    }

    // Public / Store Menu Items: Readable by everyone, writable only by admin
    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /store_menus/{storeId} {
      allow read: if true;
      allow write: if isAdmin();

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Inventory Collection: Restricted to admins
    match /inventory/{itemId} {
      allow read, write: if isAdmin();
    }

    // Coupons Collection: Authenticated users can read valid coupons; admins have full write access
    match /coupons/{couponId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Error Logs: Authenticated users can log client errors; only admins can view
    match /error_logs/{logId} {
      allow create: if isAuthenticated();
      allow read, delete: if isAdmin();
    }
  }
}
